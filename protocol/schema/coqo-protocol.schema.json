{
  "$comment": "Generated from crates/protocol by `COQO_BLESS=1 cargo test -p coqo-protocol schema`. Do not edit.",
  "$defs": {
    "AddRootParams": {
      "description": "Params of [`AddRoot`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        },
        "name": {
          "description": "Display name (default: the folder name).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Folder to add. Adding a folder that is already a root is a no-op.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "type": "object"
    },
    "ChangesParams": {
      "description": "Params of the [`Changes`] topic.",
      "properties": {
        "workspace": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace to watch. It must be open."
        }
      },
      "required": [
        "workspace"
      ],
      "type": "object"
    },
    "DaemonStatus": {
      "description": "Result of `daemon/status`.",
      "properties": {
        "build": {
          "description": "The daemon's build id (also in the handshake's `Welcome.build`).",
          "type": "string"
        },
        "busy": {
          "description": "What keeps the daemon busy (agent sessions, traces, …). Busy work\nkeeps the daemon alive with no clients attached.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "connections": {
          "description": "Clients attached right now, including the one asking.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "idle": {
          "$ref": "#/$defs/IdleStatus",
          "description": "The idle policy and where the daemon is in it."
        },
        "pid": {
          "description": "The daemon's process id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The protocol version the daemon speaks."
        },
        "startedAtMs": {
          "description": "When the daemon started, in milliseconds since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "uptimeMs": {
          "description": "How long the daemon has been running, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "The daemon's version, e.g. `0.1.0`.",
          "type": "string"
        }
      },
      "required": [
        "version",
        "build",
        "protocol",
        "pid",
        "startedAtMs",
        "uptimeMs",
        "connections",
        "busy",
        "idle"
      ],
      "type": "object"
    },
    "DirEntry": {
      "description": "One entry of a directory listing.",
      "properties": {
        "ignored": {
          "description": "Whether ignore rules exclude it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EntryKind",
          "description": "What it is. For a symlink, the kind of its target."
        },
        "mtime": {
          "description": "Last modification, in Unix milliseconds, if known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "description": "File name (the last path component).",
          "type": "string"
        },
        "size": {
          "description": "Size in bytes (of the target, for a symlink; 0 for directories).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "symlink": {
          "description": "Whether the entry itself is a symlink.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "kind",
        "symlink",
        "size",
        "ignored"
      ],
      "type": "object"
    },
    "Encoding": {
      "description": "How a frame's payload is encoded.\n\nJSON is mandatory and is always used for the handshake. MessagePack is\noptional and is switched on for the rest of the connection when both\nsides list it in the handshake; it is intended for hot paths (buffer ops,\ntrace streams).",
      "oneOf": [
        {
          "const": "json",
          "description": "UTF-8 JSON.",
          "type": "string"
        },
        {
          "const": "msgpack",
          "description": "MessagePack, with structs encoded as maps keyed by field name.",
          "type": "string"
        }
      ]
    },
    "EntryKind": {
      "description": "What a path points at.",
      "oneOf": [
        {
          "const": "file",
          "description": "A regular file.",
          "type": "string"
        },
        {
          "const": "dir",
          "description": "A directory.",
          "type": "string"
        },
        {
          "const": "other",
          "description": "Anything else: sockets, devices, and symlinks that are broken or point\noutside the workspace.",
          "type": "string"
        }
      ]
    },
    "ErrorObject": {
      "description": "A JSON-RPC 2.0 error object (§5.1).",
      "properties": {
        "code": {
          "description": "One of [`codes`] or an application-defined code.",
          "format": "int64",
          "type": "integer"
        },
        "data": {
          "description": "Structured details, if any."
        },
        "message": {
          "description": "A short human-readable description.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "EventParams": {
      "description": "Params of `coqo/event`.",
      "properties": {
        "event": {
          "description": "The event, shaped by the topic."
        },
        "seq": {
          "description": "The event's sequence number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "subscription": {
          "$ref": "#/$defs/SubscriptionId",
          "description": "The subscription this event belongs to."
        }
      },
      "required": [
        "subscription",
        "seq",
        "event"
      ],
      "type": "object"
    },
    "EventsParams": {
      "description": "Params of the [`Events`] topic.",
      "properties": {
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Only events of this workspace; omit for every workspace."
        }
      },
      "type": "object"
    },
    "FileStat": {
      "description": "Result of [`Stat`].",
      "properties": {
        "ignored": {
          "description": "Whether ignore rules exclude it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/EntryKind",
          "description": "What it is. For a symlink, the kind of its target."
        },
        "mtime": {
          "description": "Last modification, in Unix milliseconds, if known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "description": "Size in bytes (0 for directories).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "symlink": {
          "description": "Whether the path itself is a symlink.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "symlink",
        "size",
        "ignored"
      ],
      "type": "object"
    },
    "FileTooLarge": {
      "description": "`data` of a [`FILE_TOO_LARGE`](super::codes::FILE_TOO_LARGE) error.",
      "properties": {
        "limit": {
          "description": "The limit that applied.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "The file's size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "limit"
      ],
      "type": "object"
    },
    "FsChanges": {
      "description": "One event of the [`Changes`] topic: paths under one root that changed\nduring a debounce window (about 100 ms).\n\nPaths are reported, not operations: the client re-lists or re-stats them\n(a path that no longer exists was removed). Changes deep inside ignored\ndirectories (such as `target/` or `node_modules/`) and inside `.git` are\nnot reported, but an ignored entry appearing or disappearing directly in\na non-ignored directory is.",
      "properties": {
        "paths": {
          "description": "Changed paths, sorted and without duplicates. Empty when `rescan`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rescan": {
          "description": "Too much changed to report individually (or the watcher lost events):\nre-list everything under this root that the client shows.",
          "type": "boolean"
        },
        "root": {
          "$ref": "#/$defs/RootId",
          "description": "The root the paths are relative to."
        }
      },
      "required": [
        "root",
        "paths",
        "rescan"
      ],
      "type": "object"
    },
    "Hello": {
      "description": "Params of `coqo/hello`, sent by the client.",
      "properties": {
        "build": {
          "description": "The client's build id (version + commit), shown in errors and logs.",
          "type": "string"
        },
        "client": {
          "description": "What the client is, e.g. `coqo-ui`, `coqo-cli`, `coqod-mcp`.",
          "type": "string"
        },
        "encodings": {
          "default": [],
          "description": "Encodings the client accepts after the handshake, in preference\norder. JSON is always accepted, even if not listed.",
          "items": {
            "$ref": "#/$defs/Encoding"
          },
          "type": "array"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The client's protocol version."
        },
        "token": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionToken"
            },
            {
              "type": "null"
            }
          ],
          "description": "The session token that authenticates this client (since 0.1). A\nserver that authenticates (`coqod` does) rejects a missing or wrong\none with [`codes::UNAUTHORIZED`]. Never logged; servers drop it from\nthe [`Hello`] they hand to request handlers."
        }
      },
      "required": [
        "protocol",
        "build",
        "client"
      ],
      "type": "object"
    },
    "IdlePhase": {
      "description": "Where the daemon is in its idle policy.",
      "oneOf": [
        {
          "const": "active",
          "description": "A client is attached or work is busy.",
          "type": "string"
        },
        {
          "const": "idle",
          "description": "Nothing attached and nothing busy; timers are running.",
          "type": "string"
        },
        {
          "const": "servicesStopped",
          "description": "Idle long enough that services released their resources (language\nservers stopped). The daemon exits next, unless it is always on.",
          "type": "string"
        }
      ]
    },
    "IdleStatus": {
      "description": "The idle policy (PLAN §4.3) and the daemon's current idle phase.",
      "properties": {
        "exitAfterSecs": {
          "description": "Seconds with no clients and nothing busy before the daemon exits.\n`null` means never (\"always on\").",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "phase": {
          "$ref": "#/$defs/IdlePhase",
          "description": "The current phase."
        },
        "stopServicesAfterSecs": {
          "description": "Seconds with no clients and nothing busy before idle services (such\nas language servers) stop. `null` means never.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "phase"
      ],
      "type": "object"
    },
    "IncompatibleProtocol": {
      "description": "`data` of the [`codes::INCOMPATIBLE_PROTOCOL`] error.",
      "properties": {
        "build": {
          "description": "The server's build id.",
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The server's protocol version."
        }
      },
      "required": [
        "protocol",
        "build"
      ],
      "type": "object"
    },
    "ListDirResult": {
      "description": "Result of [`ListDir`].",
      "properties": {
        "entries": {
          "description": "Entries: directories first, then files, each sorted by name.",
          "items": {
            "$ref": "#/$defs/DirEntry"
          },
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "type": "object"
    },
    "ListResult": {
      "description": "Result of [`List`]: a snapshot of every known workspace.",
      "properties": {
        "seq": {
          "description": "The event-log `seq` this snapshot reflects. Subscribe to [`Events`]\nwith `since` set to it to get every later change.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "workspaces": {
          "description": "Every known workspace, most recently opened first.",
          "items": {
            "$ref": "#/$defs/WorkspaceInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "workspaces",
        "seq"
      ],
      "type": "object"
    },
    "OpenParams": {
      "description": "Params of [`Open`]. Give exactly one of `path` and `id`.",
      "properties": {
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkspaceId"
            },
            {
              "type": "null"
            }
          ],
          "description": "Reopen a known workspace."
        },
        "name": {
          "description": "Name for a newly created workspace (default: the folder name).",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Open the workspace for this folder, creating it if needed. A\nworkspace whose first root is this folder (after canonicalising\nthe path) is reused, so opening the same folder twice is idempotent.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "PathParams": {
      "description": "Params naming a path in a workspace.",
      "properties": {
        "path": {
          "default": "",
          "description": "`/`-separated path relative to the root; `\"\"` for the root itself.",
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/RootId",
          "description": "The root the path is relative to."
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        }
      },
      "required": [
        "workspace",
        "root"
      ],
      "type": "object"
    },
    "ProtocolVersion": {
      "description": "A protocol version: `major.minor`.",
      "properties": {
        "major": {
          "description": "Incremented for breaking changes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minor": {
          "description": "Incremented for additive changes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "type": "object"
    },
    "ReadParams": {
      "description": "Params of [`ReadFile`].",
      "properties": {
        "maxBytes": {
          "description": "Fail with [`FILE_TOO_LARGE`](super::codes::FILE_TOO_LARGE) if the\nfile is larger. Default [`DEFAULT_READ_LIMIT`], at most\n[`MAX_READ_LIMIT`].",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "path": {
          "description": "`/`-separated path relative to the root.",
          "type": "string"
        },
        "root": {
          "$ref": "#/$defs/RootId",
          "description": "The root the path is relative to."
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        }
      },
      "required": [
        "workspace",
        "root",
        "path"
      ],
      "type": "object"
    },
    "ReadResult": {
      "description": "Result of [`ReadFile`].",
      "properties": {
        "binary": {
          "description": "Whether the file is not valid UTF-8 (then `text` is absent).",
          "type": "boolean"
        },
        "mtime": {
          "description": "Last modification, in Unix milliseconds, if known.",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "size": {
          "description": "Size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "text": {
          "description": "The contents, if they are valid UTF-8.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "binary",
        "size"
      ],
      "type": "object"
    },
    "RemoveRootParams": {
      "description": "Params of [`RemoveRoot`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        },
        "root": {
          "$ref": "#/$defs/RootId",
          "description": "The root to remove. The last root cannot be removed."
        }
      },
      "required": [
        "id",
        "root"
      ],
      "type": "object"
    },
    "RenameParams": {
      "description": "Params of [`Rename`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        },
        "name": {
          "description": "The new display name (not empty).",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "type": "object"
    },
    "ResumeGap": {
      "description": "`data` of a [`RESUME_GAP`](codes::RESUME_GAP) error.",
      "properties": {
        "head": {
          "description": "The source's latest sequence number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "needed": {
          "description": "The first sequence number the subscriber needed.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "oldest": {
          "description": "The oldest sequence number still available (`head + 1` if none).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "needed",
        "oldest",
        "head"
      ],
      "type": "object"
    },
    "RootId": {
      "description": "Identifies a root within its workspace. Stable for the root's lifetime and\nnever reused within the workspace.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "SessionToken": {
      "description": "A secret that authenticates a connection: the daemon's per-boot token,\nor a token scoped to one workspace and agent session.\n\nIt is a string on the wire. `Debug` prints `SessionToken(<redacted>)`\nand equality is constant-time, so the token neither leaks into logs nor\nthrough comparison timing. Use [`SessionToken::expose`] only to send or\nstore it.",
      "type": "string"
    },
    "SetStateParams": {
      "description": "Params of [`SetState`].",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        },
        "key": {
          "description": "The entry to set (1–128 characters).",
          "type": "string"
        },
        "value": {
          "description": "The new value; `null` removes the entry."
        }
      },
      "required": [
        "id",
        "key",
        "value"
      ],
      "type": "object"
    },
    "ShutdownParams": {
      "description": "Params of `daemon/shutdown`.",
      "properties": {
        "force": {
          "default": false,
          "description": "Stop even if work is busy.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "ShutdownResult": {
      "description": "Result of `daemon/shutdown`.",
      "properties": {
        "busy": {
          "description": "When not stopping: the busy work that kept it running.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stopping": {
          "description": "Whether the daemon is stopping. It closes every connection and exits\nshortly after answering.",
          "type": "boolean"
        }
      },
      "required": [
        "stopping",
        "busy"
      ],
      "type": "object"
    },
    "SubscribeParams": {
      "description": "Params of `coqo/subscribe`.",
      "properties": {
        "params": {
          "default": null,
          "description": "Topic-specific params (`null` if none)."
        },
        "since": {
          "description": "Resume after this sequence number; omit for live events only.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "topic": {
          "description": "Topic name.",
          "type": "string"
        }
      },
      "required": [
        "topic"
      ],
      "type": "object"
    },
    "SubscribeResult": {
      "description": "Result of `coqo/subscribe`.",
      "properties": {
        "head": {
          "description": "The source's latest sequence number when the subscription started.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "subscription": {
          "$ref": "#/$defs/SubscriptionId",
          "description": "Id used in `coqo/event` notifications and `coqo/unsubscribe`."
        }
      },
      "required": [
        "subscription",
        "head"
      ],
      "type": "object"
    },
    "SubscriptionEndedParams": {
      "description": "Params of `coqo/subscriptionEnded`.",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorObject"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why, if it ended abnormally."
        },
        "subscription": {
          "$ref": "#/$defs/SubscriptionId",
          "description": "The subscription that ended."
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "SubscriptionId": {
      "description": "Identifies a subscription on one connection.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "UnsubscribeParams": {
      "description": "Params of `coqo/unsubscribe`.",
      "properties": {
        "subscription": {
          "$ref": "#/$defs/SubscriptionId",
          "description": "The subscription to stop."
        }
      },
      "required": [
        "subscription"
      ],
      "type": "object"
    },
    "Welcome": {
      "description": "Result of `coqo/hello`, sent by the server.",
      "properties": {
        "build": {
          "description": "The server's build id. Equal builds are compatible by definition;\ndifferent builds are compatible when the protocol versions are.",
          "type": "string"
        },
        "connection": {
          "description": "A server-assigned id for this connection, unique per server process.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "encoding": {
          "$ref": "#/$defs/Encoding",
          "description": "The encoding both sides use from the next frame on."
        },
        "negotiated": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The negotiated version for this connection."
        },
        "protocol": {
          "$ref": "#/$defs/ProtocolVersion",
          "description": "The server's protocol version."
        },
        "server": {
          "description": "What the server is, e.g. `coqod`.",
          "type": "string"
        }
      },
      "required": [
        "protocol",
        "negotiated",
        "build",
        "server",
        "encoding",
        "connection"
      ],
      "type": "object"
    },
    "WorkspaceEvent": {
      "description": "One event of the [`Events`] topic.",
      "oneOf": [
        {
          "description": "A workspace was opened (or created and opened).",
          "properties": {
            "type": {
              "const": "opened",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/WorkspaceInfo",
              "description": "The workspace after the change."
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "description": "A workspace was closed.",
          "properties": {
            "type": {
              "const": "closed",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/WorkspaceInfo",
              "description": "The workspace after the change."
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "description": "A workspace's name or roots changed.",
          "properties": {
            "type": {
              "const": "changed",
              "type": "string"
            },
            "workspace": {
              "$ref": "#/$defs/WorkspaceInfo",
              "description": "The workspace after the change."
            }
          },
          "required": [
            "type",
            "workspace"
          ],
          "type": "object"
        },
        {
          "description": "A workspace was removed (forgotten; its folders are untouched).",
          "properties": {
            "id": {
              "$ref": "#/$defs/WorkspaceId",
              "description": "The removed workspace."
            },
            "type": {
              "const": "removed",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "A state entry was set or removed.",
          "properties": {
            "id": {
              "$ref": "#/$defs/WorkspaceId",
              "description": "The workspace."
            },
            "key": {
              "description": "The entry.",
              "type": "string"
            },
            "type": {
              "const": "stateChanged",
              "type": "string"
            },
            "value": {
              "description": "The new value; `null` if it was removed."
            }
          },
          "required": [
            "type",
            "id",
            "key",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "WorkspaceId": {
      "description": "Stable identifier of a workspace, e.g. `ws-3f2a9c1d0b7e4a65`.",
      "type": "string"
    },
    "WorkspaceInfo": {
      "description": "A workspace as the daemon knows it.",
      "properties": {
        "createdAt": {
          "description": "When the workspace was created, in Unix milliseconds.",
          "format": "int64",
          "type": "integer"
        },
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "Stable id."
        },
        "lastOpenedAt": {
          "description": "When the workspace was last opened, in Unix milliseconds.",
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "description": "Display name.",
          "type": "string"
        },
        "open": {
          "description": "Whether the workspace is open (watched, shown in the rail).",
          "type": "boolean"
        },
        "roots": {
          "description": "Folder roots, in display order. Never empty.",
          "items": {
            "$ref": "#/$defs/WorkspaceRoot"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "roots",
        "createdAt",
        "lastOpenedAt",
        "open"
      ],
      "type": "object"
    },
    "WorkspaceParams": {
      "description": "Params naming one workspace.",
      "properties": {
        "id": {
          "$ref": "#/$defs/WorkspaceId",
          "description": "The workspace."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "WorkspaceRoot": {
      "description": "One folder root of a workspace.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RootId",
          "description": "The root's id within the workspace."
        },
        "name": {
          "description": "Display name (the folder name by default).",
          "type": "string"
        },
        "path": {
          "description": "Absolute, canonical path of the folder.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path",
        "name"
      ],
      "type": "object"
    },
    "WorkspaceState": {
      "description": "A workspace's persisted state document, e.g. `tabs`, `layout`,\n`settings`. The keys and values belong to the UI; the daemon only stores\nthem.",
      "properties": {
        "entries": {
          "additionalProperties": true,
          "description": "State entries by key.",
          "type": "object"
        },
        "seq": {
          "description": "The event-log `seq` this snapshot reflects (see [`ListResult::seq`]).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "entries",
        "seq"
      ],
      "type": "object"
    }
  },
